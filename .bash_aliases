alias goblin='cd /mnt/Goblinvault'
alias home='cd ~'
alias docs='cd ~/Documents'
alias downloads='cd ~/Downloads'
alias please='sudo'
alias updateall='sudo apt update && sudo apt upgrade -y && flatpak update -y'
alias storage='du -sh ~/* ~/.??* 2>/dev/null | sort -h'
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'
alias ll='ls -lah'
alias disks='df -h'
alias psg='ps aux | grep'
alias myip='curl ifconfig.me'
>alias weather='curl wttr.in'
alias bye='systemctl poweroff'
alias rebooty='systemctl reboot'
alias flex='neofetch'
alias bashedit='nano ~/.bashrc'
alias aliasedit='nano ~/.bash_aliases'
alias reload='source ~/.bashrc'
alias exorcism='~/scripts/filesystem_exorcism.sh'
alias backupdot='~/scripts/dotfile-backup.sh'

